{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "friendlamp",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // No database_id on purpose: the first `npm run deploy` creates the database
  // and writes its id back into this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friendlamp"
    }
  ]
}
